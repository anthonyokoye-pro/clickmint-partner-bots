# 1) Copy this file:   cp .env.example .env
# 2) Fill in the real values (NEVER commit .env — it's git-ignored).
# 3) Each variable is read by config.py. On a server, set these as env vars too.

# One bot token per bot. Create 3 bots in @BotFather and paste their tokens.
REWARD_BOT_TOKEN=1234567890:AA....paste...
PARTNER_BOT_TOKEN=1234567890:AA....paste...
ADMIN_BOT_TOKEN=1234567890:AA....paste...

# YOUR numeric Telegram user id (get it from @userinfobot). The owner.
OWNER_USER_ID=123456789

# Optional: where the JSON store files live (default = the current dir).
# STORE_DIR=/home/clickmint/data

# After running the migration and staging verification, activate the
# transactional Mint/referral/posting backend.
# MINT_LEDGER_MODE=transactional
# MINT_DB_PATH=/home/clickmint/data/mint.sqlite3

# Optional SQLite paths (default to STORE_DIR).
# TASK_DB_PATH=/home/clickmint/data/tasks.sqlite3
# CREDIBILITY_DB_PATH=/home/clickmint/data/credibility.sqlite3
# BROADCAST_DB_PATH=/home/clickmint/data/broadcast.sqlite3
# ADMIN_API_DB_PATH=/home/clickmint/data/admin_api.sqlite3
# ENFORCEMENT_DB_PATH=/home/clickmint/data/enforcement.sqlite3
# ADMIN_ALLOWED_ORIGINS=https://admin.example.com,https://web.telegram.org

# Loaded automatically by config.py (requires `pip install python-dotenv`).
