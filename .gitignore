# ---- SECRETS: never commit your tokens / owner id ----
.env
env

# ---- Runtime state: the bots' whole "database" is these JSON files ----
# (they are generated at runtime; keep them OUT of git so you don't leak data
#  and so they survive deploys as persistent files)
reward_ledger.json
partnership_state.json
*.lock
# NOTE: deliberately NOT a blanket `*.json` — that also swallowed any config or
# seed file we might legitimately want to commit. Add new runtime files by name.

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- Editors / OS ----
.DS_Store
.idea/
.vscode/
*.log
