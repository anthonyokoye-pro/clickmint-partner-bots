# Copy to .env.staging and fill with DEDICATED staging resources.
# Never reuse production bot tokens, owner/database paths, encryption keys, or origins.
ENVIRONMENT=staging

REWARD_BOT_TOKEN=staging-reward-token-from-botfather
PARTNER_BOT_TOKEN=staging-partner-token-from-botfather
ADMIN_BOT_TOKEN=staging-admin-token-from-botfather
OWNER_USER_ID=123456789
CLICKMINT_CREDENTIAL_KEY=replace-with-a-new-random-staging-secret-at-least-32-characters

ADMIN_ALLOWED_ORIGINS=https://staging.example
ONBOARDING_WEBAPP_URL=https://staging.example/onboarding_web/

# Keep every staging database under a separate staging directory.
STORE_DIR=/srv/clickmint-staging/data
MINT_DB_PATH=/srv/clickmint-staging/data/mint.sqlite3
TASK_DB_PATH=/srv/clickmint-staging/data/tasks.sqlite3
BROADCAST_DB_PATH=/srv/clickmint-staging/data/broadcast.sqlite3
VERIFICATION_DB_PATH=/srv/clickmint-staging/data/verification.sqlite3
PLATFORM_DB_PATH=/srv/clickmint-staging/data/platform.sqlite3
CREDIBILITY_DB_PATH=/srv/clickmint-staging/data/credibility.sqlite3
ENFORCEMENT_DB_PATH=/srv/clickmint-staging/data/enforcement.sqlite3
ADS_DB_PATH=/srv/clickmint-staging/data/ads.sqlite3
ADMIN_API_DB_PATH=/srv/clickmint-staging/data/admin_api.sqlite3
WORKER_DB_PATH=/srv/clickmint-staging/data/worker.sqlite3

# Financial features remain disabled in staging.
DEPOSITS_ENABLED=false
WITHDRAWALS_ENABLED=false
CRYPTO_PAYMENTS_ENABLED=false
FIAT_PAYMENTS_ENABLED=false
TELEGRAM_STARS_ENABLED=false
BOOST_PURCHASES_ENABLED=false
EXTERNAL_PAYOUTS_ENABLED=false
CURRENCY_CONVERSION_ENABLED=false
ADS_ENABLED=false
